
MONGODB_URI=mongodb://localhost:27017/priyoshop
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# Optional, comma-separated extra origins allowed to call Better Auth (e.g. your LAN IP for device testing)
BETTER_AUTH_TRUSTED_ORIGINS=http://172.30.96.1:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LOGGING_LEVEL=debug
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now

# Storage Provider: cloudinary | s3 | local
STORAGE_PROVIDER=cloudinary

# Cloudinary Credentials (Free Plan)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=priyoshop

# Optional S3 / MinIO / R2 (when switching to self-hosted cloud server)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=your-bucket-name
# S3_ACCESS_KEY_ID=your-key-id
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_PUBLIC_DOMAIN=https://cdn.yourdomain.com

